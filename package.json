{
  "name": "dreamchord",
  "version": "0.2.0",
  "private": true,
  "description": "梦弦 DreamChord - 节点式视觉小说创作平台",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "prepare:workspace": "pnpm --filter @dreamchord/story-domain build && pnpm --filter dreamchord-server prisma generate",
    "pretest": "pnpm prepare:workspace",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:readiness": "node scripts/workspace-readiness.test.mjs",
    "test:presentation": "node scripts/check-presentation-assets.mjs",
    "test:voice-runtime": "node --test scripts/voice-runtime-config.test.mjs scripts/cosyvoice-runtime-config.test.mjs scripts/starter-voice-manifest.test.mjs scripts/starter-music-manifest.test.mjs scripts/official-soundtrack-manifest.test.mjs scripts/bilingual-cast-manifest.test.mjs",
    "voice:setup": "pwsh -NoProfile -File scripts/setup-gpt-sovits.ps1",
    "voice:setup:cpu": "pwsh -NoProfile -File scripts/setup-gpt-sovits.ps1 -Device CPU",
    "voice:cosy:setup": "pwsh -NoProfile -File scripts/setup-cosyvoice.ps1",
    "voice:cosy:smoke": "pnpm --filter dreamchord-server build && node scripts/cosyvoice-smoke.mjs",
    "voice:cosy:auditions": "pnpm --filter dreamchord-server exec tsx prisma/seedCosyVoiceAuditions.ts",
    "voice:cast:setup": "pwsh -NoProfile -File scripts/setup-qwen-cast.ps1",
    "voice:cast:seed": "pnpm --filter dreamchord-server exec tsx prisma/seedBilingualCast.ts",
    "voice:translation:setup": "pwsh -NoProfile -File scripts/setup-voice-translation.ps1",
    "demo:localize": "pnpm --filter @dreamchord/story-domain build && pnpm --filter dreamchord-server exec tsx prisma/syncOfficialLocalization.ts",
    "voice:starter:generate": "pwsh -NoProfile -File scripts/generate-starter-voices.ps1",
    "voice:seed": "pnpm --filter dreamchord-server exec tsx prisma/seedStarterVoices.ts",
    "music:starter:generate": "node scripts/generate-starter-music.mjs",
    "music:official:install": "pwsh -NoProfile -File scripts/install-official-soundtrack.ps1",
    "music:seed": "pnpm --filter dreamchord-server exec tsx prisma/seedStarterMusic.ts",
    "lint": "pnpm -r lint",
    "db:migrate": "pnpm --filter server prisma migrate dev",
    "db:generate": "pnpm --filter server prisma generate",
    "db:seed": "pnpm --filter server prisma db seed",
    "db:studio": "pnpm --filter server prisma studio"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@types/node": "^20.14.0",
    "eslint": "9.39.1",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.0.0",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.0.0"
  },
  "packageManager": "pnpm@9.1.0"
}
