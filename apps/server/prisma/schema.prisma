generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  username      String    @unique
  password      String
  nickname      String?
  avatar        String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  projects      Project[]
  comments      Comment[]
  agentConversations AgentConversation[]
  agentRuns     AgentRun[]
  agentMemories AgentMemory[]
  assets        Asset[]
  longTextImports LongTextImport[]
  voiceProfiles VoiceProfile[]
  voiceGenerationJobs VoiceGenerationJob[]

  @@map("users")
}

model Project {
  id            String    @id @default(uuid())
  title         String
  description   String?
  cover         String    @default("/assets/covers/default-cover.png")
  defaultSubtitleLocale String @default("zh") @map("default_subtitle_locale")
  defaultVoiceLocale String @default("zh") @map("default_voice_locale")
  isPublic      Boolean   @default(false) @map("is_public")
  isPublished   Boolean   @default(false) @map("is_published")
  playCount     Int       @default(0) @map("play_count")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  authorId      String    @map("author_id")
  author        User      @relation(fields: [authorId], references: [id], onDelete: Cascade)

  chapters      Chapter[]
  characters    Character[]
  assets        Asset[]
  comments      Comment[]
  storyBible    StoryBible?
  agentConversations AgentConversation[]
  agentRuns     AgentRun[]
  storyPatches  StoryPatch[]
  agentMemories AgentMemory[]
  longTextImports LongTextImport[]
  characterVoiceBindings CharacterVoiceBinding[]
  voiceGenerationJobs VoiceGenerationJob[]

  @@index([authorId])
  @@map("projects")
}

model Chapter {
  id            String    @id @default(uuid())
  title         String    @default("未命名章节")
  order         Int       @default(0)
  version       Int       @default(1)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  projectId     String    @map("project_id")
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  nodes         FlowNode[]
  edges         FlowEdge[]
  agentRuns     AgentRun[]
  storyPatches  StoryPatch[]
  snapshots     ChapterSnapshot[]

  @@index([projectId])
  @@map("chapters")
}

model FlowNode {
  id            String    @id @default(uuid())
  nodeId        String    @map("node_id")
  type          String
  positionX     Float     @map("position_x")
  positionY     Float     @map("position_y")
  data          String

  chapterId     String    @map("chapter_id")
  chapter       Chapter   @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@index([chapterId])
  @@unique([chapterId, nodeId])
  @@map("flow_nodes")
}

model FlowEdge {
  id            String    @id @default(uuid())
  edgeId        String    @map("edge_id")
  source        String
  target        String
  label         String?
  sourceHandle  String?   @map("source_handle")
  animated      Boolean   @default(true)

  chapterId     String    @map("chapter_id")
  chapter       Chapter   @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@index([chapterId])
  @@unique([chapterId, edgeId])
  @@map("flow_edges")
}

model Character {
  id            String    @id @default(uuid())
  name          String
  description   String?
  color         String    @default("#8b5cf6")
  defaultSprite String    @default("/assets/characters/default-avatar.png") @map("default_sprite")
  createdAt     DateTime  @default(now()) @map("created_at")

  projectId     String    @map("project_id")
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  sprites       Sprite[]
  voiceBinding  CharacterVoiceBinding?
  voiceGenerationJobs VoiceGenerationJob[]

  @@index([projectId])
  @@unique([projectId, name])
  @@map("characters")
}

model Sprite {
  id            String    @id @default(uuid())
  name          String    @default("default")
  url           String

  characterId   String    @map("character_id")
  character     Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@index([characterId])
  @@map("sprites")
}

model Asset {
  id            String    @id @default(uuid())
  name          String
  type          String    @default("OTHER")
  url           String
  createdAt     DateTime  @default(now()) @map("created_at")
  mimeType      String?   @map("mime_type")
  width         Int?
  height        Int?
  hasAlpha      Boolean?  @map("has_alpha")
  status        String    @default("ready")
  metadata      String    @default("{}")

  ownerId       String    @map("owner_id")
  owner         User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  projectId     String?   @map("project_id")
  project       Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  variants      AssetVariant[]
  voiceReference VoiceReference?
  acceptedVoiceJobs VoiceGenerationJob[] @relation("AcceptedVoiceAsset")

  @@index([ownerId, createdAt])
  @@index([projectId])
  @@map("assets")
}

model Comment {
  id            String    @id @default(uuid())
  content       String
  createdAt     DateTime  @default(now()) @map("created_at")

  authorId      String    @map("author_id")
  author        User      @relation(fields: [authorId], references: [id], onDelete: Cascade)

  projectId     String    @map("project_id")
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([authorId])
  @@map("comments")
}

model StoryBible {
  id        String   @id @default(uuid())
  content   String   @default("{}")
  version   Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  projectId String  @unique @map("project_id")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("story_bibles")
}

model AgentConversation {
  id        String   @id @default(uuid())
  title     String
  scope     String
  chapterId String?  @map("chapter_id")
  isPinned  Boolean  @default(false) @map("is_pinned")
  summary   String   @default("")
  summaryThroughMessageId String? @map("summary_through_message_id")
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  userId    String  @map("user_id")
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId String  @map("project_id")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  messages AgentMessage[]
  runs     AgentRun[]
  memories AgentMemory[]

  @@index([userId, projectId])
  @@map("agent_conversations")
}

model AgentMessage {
  id        String   @id @default(uuid())
  role      String
  content   String
  metadata  String   @default("{}")
  createdAt DateTime @default(now()) @map("created_at")

  conversationId String            @map("conversation_id")
  conversation   AgentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("agent_messages")
}

model AgentRun {
  id            String    @id @default(uuid())
  status        String    @default("queued")
  prompt        String
  scope         String
  targetId      String?   @map("target_id")
  provider      String
  model         String
  plan          String    @default("[]")
  timeline      String    @default("[]")
  sources       String    @default("[]")
  validation    String    @default("{}")
  errorCode     String?   @map("error_code")
  errorMessage  String?   @map("error_message")
  usage         String    @default("{}")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  completedAt   DateTime? @map("completed_at")

  userId         String            @map("user_id")
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId      String            @map("project_id")
  project        Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  chapterId      String?           @map("chapter_id")
  chapter        Chapter?          @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  conversationId String            @map("conversation_id")
  conversation   AgentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  patch           StoryPatch?

  @@index([userId, projectId])
  @@index([status])
  @@index([conversationId, createdAt])
  @@map("agent_runs")
}

model StoryPatch {
  id             String    @id @default(uuid())
  payload        String
  validation     String    @default("{}")
  diff           String    @default("{}")
  status         String    @default("proposed")
  baseVersion    Int       @map("base_version")
  appliedVersion Int?      @map("applied_version")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  runId     String   @unique @map("run_id")
  run       AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  projectId String   @map("project_id")
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  chapterId String   @map("chapter_id")
  chapter   Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  snapshot  ChapterSnapshot?

  @@index([projectId, chapterId])
  @@index([status])
  @@map("story_patches")
}

model ChapterSnapshot {
  id        String   @id @default(uuid())
  nodes     String
  edges     String
  version   Int
  createdAt DateTime @default(now()) @map("created_at")

  patchId   String     @unique @map("patch_id")
  patch     StoryPatch @relation(fields: [patchId], references: [id], onDelete: Cascade)
  chapterId String     @map("chapter_id")
  chapter   Chapter    @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@index([chapterId])
  @@map("chapter_snapshots")
}

model AssetVariant {
  id        String   @id @default(uuid())
  kind      String
  status    String   @default("proposed")
  url       String
  mimeType  String   @map("mime_type")
  width     Int
  height    Int
  metadata  String   @default("{}")
  createdAt DateTime @default(now()) @map("created_at")

  assetId   String @map("asset_id")
  asset     Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId, status])
  @@map("asset_variants")
}

model AgentMemory {
  id             String   @id @default(uuid())
  kind           String
  status         String   @default("suggested")
  title          String
  content        String
  tags           String   @default("[]")
  importance     Int      @default(50)
  isPinned       Boolean  @default(false) @map("is_pinned")
  sourceType     String   @default("assistant") @map("source_type")
  sourceId       String?  @map("source_id")
  forgottenAt    DateTime? @map("forgotten_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  userId         String   @map("user_id")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId      String   @map("project_id")
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  conversationId String?  @map("conversation_id")
  conversation   AgentConversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  supersededById String?  @map("superseded_by_id")
  supersededBy   AgentMemory? @relation("MemorySupersession", fields: [supersededById], references: [id], onDelete: SetNull)
  supersedes     AgentMemory[] @relation("MemorySupersession")

  @@index([userId, projectId, status])
  @@index([conversationId, status])
  @@map("agent_memories")
}

model LongTextImport {
  id            String   @id @default(uuid())
  fileName      String
  sourceText    String   @map("source_text")
  status        String   @default("queued")
  chunkSize     Int      @default(12000) @map("chunk_size")
  totalChunks   Int      @default(0) @map("total_chunks")
  completedChunks Int    @default(0) @map("completed_chunks")
  failedChunks  Int      @default(0) @map("failed_chunks")
  errorMessage  String?  @map("error_message")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  completedAt   DateTime? @map("completed_at")

  userId        String   @map("user_id")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId     String   @map("project_id")
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  chunks        LongTextImportChunk[]

  @@index([userId, projectId, createdAt])
  @@index([status, updatedAt])
  @@map("long_text_imports")
}

model LongTextImportChunk {
  id          String   @id @default(uuid())
  index       Int
  chapterTitle String  @map("chapter_title")
  text        String
  startOffset Int      @map("start_offset")
  endOffset   Int      @map("end_offset")
  status      String   @default("queued")
  attempts    Int      @default(0)
  outputText  String?  @map("output_text")
  errorMessage String? @map("error_message")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  importId    String   @map("import_id")
  import      LongTextImport @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@unique([importId, index])
  @@index([importId, status])
  @@map("long_text_import_chunks")
}

model VoiceProfile {
  id                    String   @id @default(uuid())
  name                  String
  description           String   @default("")
  language              String
  ageTone               String   @default("") @map("age_tone")
  genderTone            String   @default("") @map("gender_tone")
  tags                   String   @default("[]")
  provider              String   @default("gpt-sovits")
  defaultEmotion        String   @default("自然") @map("default_emotion")
  defaultSpeed          Float    @default(1) @map("default_speed")
  authorizationNote     String   @map("authorization_note")
  status                String   @default("active")
  previewUrl            String?  @map("preview_url")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  ownerId               String   @map("owner_id")
  owner                 User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  references            VoiceReference[]
  bindings              CharacterVoiceBinding[]
  generationJobs        VoiceGenerationJob[]

  @@index([ownerId, status, createdAt])
  @@map("voice_profiles")
}

model VoiceReference {
  id                    String   @id @default(uuid())
  transcript            String
  language              String
  emotion               String   @default("自然")
  authorizationConfirmed Boolean @default(false) @map("authorization_confirmed")
  status                String   @default("active")
  createdAt             DateTime @default(now()) @map("created_at")

  profileId             String   @map("profile_id")
  profile               VoiceProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  assetId               String   @unique @map("asset_id")
  asset                 Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  generationJobs        VoiceGenerationJob[]

  @@index([profileId, status])
  @@map("voice_references")
}

model CharacterVoiceBinding {
  id                    String   @id @default(uuid())
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  projectId             String   @map("project_id")
  project               Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  characterId           String   @unique @map("character_id")
  character             Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  profileId             String   @map("profile_id")
  profile               VoiceProfile @relation(fields: [profileId], references: [id], onDelete: Restrict)

  @@index([projectId])
  @@index([profileId])
  @@map("character_voice_bindings")
}

model VoiceGenerationJob {
  id                    String   @id @default(uuid())
  status                String   @default("queued")
  text                  String
  language              String
  emotion               String   @default("自然")
  speed                 Float    @default(1)
  seed                  Int?
  nodeId                String?  @map("node_id")
  outputUrl             String?  @map("output_url")
  outputMimeType        String?  @map("output_mime_type")
  errorMessage          String?  @map("error_message")
  providerMetadata      String   @default("{}") @map("provider_metadata")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")
  completedAt           DateTime? @map("completed_at")

  ownerId               String   @map("owner_id")
  owner                 User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  projectId             String   @map("project_id")
  project               Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  characterId           String   @map("character_id")
  character             Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  chapterId             String?  @map("chapter_id")
  profileId             String   @map("profile_id")
  profile               VoiceProfile @relation(fields: [profileId], references: [id], onDelete: Restrict)
  referenceId           String   @map("reference_id")
  reference             VoiceReference @relation(fields: [referenceId], references: [id], onDelete: Restrict)
  acceptedAssetId       String?  @map("accepted_asset_id")
  acceptedAsset         Asset?   @relation("AcceptedVoiceAsset", fields: [acceptedAssetId], references: [id], onDelete: SetNull)

  @@index([ownerId, status, createdAt])
  @@index([projectId, characterId])
  @@map("voice_generation_jobs")
}
