# 数据库（开发使用 SQLite，生产可切换为 PostgreSQL）
DATABASE_URL="file:./dev.db"

# 服务端密钥（必须设置，长度至少 16 字符，生产环境建议 32+ 字符）
JWT_SECRET="please-change-this-to-a-random-secret-key-at-least-16-chars"
PORT=3001

# CORS 白名单（逗号分隔，包含所有可能的前端端口）
CORS_ORIGIN="http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:5175,http://127.0.0.1:5175,http://localhost:5176,http://127.0.0.1:5176,http://localhost:4173"

# 文件存储
UPLOAD_DIR="./uploads"

# 内置本机角色配音生成。执行 pnpm voice:setup 一次后，DreamChord 会自动后台启动。
# 只监听 localhost/127.0.0.1，且不会在正式播放时现场生成。
VOICE_PROVIDER="gpt-sovits"
GPT_SOVITS_BASE_URL="http://127.0.0.1:9880"
GPT_SOVITS_TIMEOUT_MS=120000
GPT_SOVITS_AUTO_START=true
# 通常无需填写；仅当你把引擎安装到别处时使用。
# GPT_SOVITS_HOME="D:/AI/GPT-SoVITS"
# GPT_SOVITS_PYTHON="D:/AI/GPT-SoVITS/.conda/python.exe"

# 可选：服务端默认 AI 配置（用户也可以在设置里配置自己的 Key）
# 智谱 GLM: https://open.bigmodel.cn/
GLM_API_KEY=""
GLM_BASE_URL="https://open.bigmodel.cn/api/paas/v4"

# DeepSeek: https://platform.deepseek.com/
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com"

# Kimi (Moonshot): https://platform.moonshot.cn/
KIMI_API_KEY=""
KIMI_BASE_URL="https://api.moonshot.cn/v1"
